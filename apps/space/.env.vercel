# Browser-visible configuration for https://app.flyst.techyst.net.
# Paste into Vercel → Settings → Environment Variables, or import with
#   vercel env add < .env.vercel
# Server secrets do not belong here; they are compiled into the bundle.
VITE_API_BASE_URL=https://api.flyst.techyst.net
VITE_WEB_BASE_URL=https://app.flyst.techyst.net
VITE_ADMIN_BASE_URL=https://admin.flyst.techyst.net
VITE_SPACE_BASE_URL=https://space.flyst.techyst.net
VITE_LIVE_BASE_URL=https://live.flyst.techyst.net
